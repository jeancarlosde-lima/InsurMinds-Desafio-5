# Copie este arquivo para .env e preencha com suas credenciais.
# O arquivo .env NAO deve ser versionado (ja consta no .gitignore).

# Chave da API do Google AI Studio (modelo Gemini)
GOOGLE_API_KEY=coloque_sua_chave_aqui

# Parametros opcionais
MODELO_LLM=gemini-3.6-flash
TEMPERATURA_LLM=0.4
JANELA_ANTECEDENCIA_H=48
COOLDOWN_H=24
